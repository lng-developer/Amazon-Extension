{
  "manifest_version": 3,
  "name": "AMZ EXTENSION LNG",
  "version": "0.3.4",
  "description": "Auto Pull Order - LNG Group",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://m.media-amazon.com/*",
    "https://sellercentral.amazon.com/*",
    "https://advertising.amazon.com/*",
    "https://na.r.ads.amazon.com/*",
    "https://mail.google.com/*",
    "https://decorated-reports-prod-iad.s3.amazonaws.com/*",
    "https://api.lngmerch.co/*",
    "https://dev-api.lngmerch.co/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://advertising.amazon.com/*"],
      "js": ["ads_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://advertising.amazon.com/*"],
      "js": ["ads_main_sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail_report_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "AMZ EXTENSION LNG",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "128": "icons/logo-128.png"
    }
  }
}
